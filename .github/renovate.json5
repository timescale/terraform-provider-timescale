// The rules of default.json5, go.json5, go-toolchain-bump.json5 and
// security-alerts.json5 from timescale/renovate-config at 0221b5a, with
// timescale/renovate-config#9, that match this repo. The Mend Renovate app cannot read presets from that
// private repo in a public repo, and the org inherited config does not apply
// here either. Update this file by hand when those presets change.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'mergeConfidence:all-badges',
    'schedule:weekly',
    'security:gomodIndirectSecurityUpdates',
  ],
  labels: [
    'dependencies',
  ],
  semanticCommitType: 'chore',
  minimumReleaseAge: '7 days',
  prConcurrentLimit: 10,
  // gomodUpdateImportPaths rewrites the /vN import paths of a major bump.
  postUpdateOptions: [
    'gomodTidyAll',
    'gomodUpdateImportPaths',
  ],
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: [
      'dependencies',
      'security',
    ],
    schedule: [
      'at any time',
    ],
    // Renovate gives security PRs no release age, and its alert rules come
    // after all other rules. CI installs through Secure Registry, which
    // blocks a version for 3 days after its release.
    // Renovate forces this value on every vulnerability PR, so no package
    // rule can change it. The rule below skips the check instead.
    minimumReleaseAge: '3 days',
  },
  packageRules: [
    {
      // Secure Registry lets the fix version of a high or critical advisory
      // through its cooldown at once. Keep the severities and datasources
      // here equal to the registries that have this exemption.
      // The rule matches only when every advisory of the package is high or
      // critical. With a lower-severity advisory, Renovate can pick a newer
      // fix that the registry blocks, and then CI fails with no new commit
      // to run it again.
      // The rule reads the severity of each advisory from the PR notes,
      // because vulnerabilitySeverity keeps one value per dependency and
      // ranks UNKNOWN above CRITICAL. A GO- record has no severity, so the
      // rule accepts an unscored note whose alias line shares a GHSA or CVE
      // id with a high or critical note.
      // If Renovate changes the note format, the rule stops matching and
      // the 3-day hold applies again.
      description: 'High and critical vulnerability fixes: no release-age hold, so their PRs open at once',
      matchDatasources: [
        'go',
      ],
      matchJsonata: [
        "( \
          $notes := prBodyNotes[$contains($, /(^|\\n)#### Severity\\n/)]; \
          $sev := function($n) { $match($n, /(?:^|\\n)#### Severity\\n(?:- CVSS Score: [0-9.]+ \\/ 10 \\()?([A-Za-z]+)/)[0].groups[0] }; \
          $ids := function($n) { $match($split($substringBefore($n, '\\n\\n<details>'), '\\n')[-1], /GHSA(?:-[0-9a-z]{4}){3}|CVE-[0-9]+-[0-9]+/).match }; \
          $high := $notes[$sev($) in ['High', 'Critical']]; \
          $highIds := $high.$ids($); \
          isVulnerabilityAlert = true and $count($high) > 0 and $count($notes[$not($sev($) in ['High', 'Critical'] or ($sev($) = 'Unknown' and $count($ids($)[$ in $highIds]) > 0))]) = 0 \
        )",
      ],
      internalChecksFilter: 'none',
      statusCheckWhen: {
        minimumReleaseAge: 'never',
      },
    },
    {
      // No automerge: main requires a code-owner review, and the
      // renovate-approve app is not a code owner. Without automerge,
      // Renovate also rebases the PR only on a conflict, so it does not
      // run the acceptance tests again after each merge to main.
      description: 'One weekly PR for every non-major update not handled by a more specific rule',
      groupName: 'non-major dependencies',
      matchUpdateTypes: [
        'digest',
        'patch',
        'minor',
        'pin',
        'pinDigest',
      ],
    },
    {
      description: 'Label major updates for manual review',
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'major-update',
      ],
    },
    {
      description: 'Group GitHub Actions updates into a single PR, majors included',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
      separateMajorMinor: false,
    },
    {
      // golangci-lint refuses to load a module whose go directive is newer
      // than the Go it was built with, so it must move with the toolchain.
      description: 'Keep the Go version of mise, the go directive of go.mod and golangci-lint in one PR',
      matchDepNames: [
        'go',
        'golangci-lint',
      ],
      groupName: 'go toolchain',
    },
    {
      description: 'Indirect Go deps: skip abandonment flagging (transitive, not ours to replace)',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'indirect',
      ],
      abandonmentThreshold: null,
    },
    {
      description: 'Go major bumps: Renovate opens the PR only after a person approves it on the Dependency Dashboard',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      // No module imports this provider, so a higher go directive forces no
      // consumer onto a newer Go.
      description: 'Renovate skips the go directive in go.mod unless the range strategy is bump',
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'go',
      ],
      matchDepTypes: [
        'golang',
      ],
      rangeStrategy: 'bump',
    },
  ],
}
